{
  "database": "Zotero",
  "noteImportFolder": "notes/{{collections[0].fullPath}}",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 100,
  "citeFormats": [
    {
      "name": "Cite",
      "format": "formatted-citation",
      "cslStyle": "bluebook-law-review"
    },
    {
      "name": "Bibliography",
      "format": "formatted-bibliography",
      "cslStyle": "bluebook-law-review"
    }
  ],
  "exportFormats": [
    {
      "name": "Zotero Source Notes",
      "outputPathTemplate": "notes/{{collections[0].fullPath}}/@{{citekey}}.md",
      "imageOutputPathTemplate": "notes/{{collections[0].fullPath}}/img/{{citekey}}",
      "imageBaseNameTemplate": "((citekey))-img",
      "templatePath": "assets/templates/zotero-notes.md",
      "cslStyle": "bluebook-law-review"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note",
  "exeOverridePath": "/home/efink/Research/Zotero/.obsidian/pdfannots2.json"
}