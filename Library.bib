@article{Lacey2019,
  title = {Populism and the Rule of Law},
  author = {Lacey, Nicola},
  date = {2019-10-13},
  journaltitle = {Annual Review of Law and Social Science},
  shortjournal = {Annu. Rev. Law Soc. Sci.},
  volume = {15},
  pages = {79--96},
  publisher = {Annual Reviews},
  issn = {1550-3585, 1550-3631},
  url = {https://www.annualreviews.org/content/journals/10.1146/annurev-lawsocsci-101518-042919},
  urldate = {2025-05-08},
  abstract = {The resurgence of populism in Europe and North America is widely thought to have placed the rule of law under pressure. But how many of the relevant developments are indeed associated with populism? And is any such association a contingent or analytic matter: Does populism inevitably threaten the rule of law, or do other conditions intervene to shape its impact? After setting out how I understand the rule of law and populism, I examine the ways in which contemporary populist discourse has challenged the rule of law through a variety of mechanisms—notably agenda setting, policy impact, influence on discretionary decisions, and convention trashing—considering the institutional and social conditions that conduce to strengthen or weaken these mechanisms in particular contexts. Finally, I consider the implications of the analysis for contemporary criminalization, assessing how many of the factors producing penal populism or overcriminalization are truly a product of populism.},
  issue = {Volume 15, 2019},
  langid = {english},
  file = {/home/efink/Zotero/storage/YRI6TKFC/@Lacey2019.pdf}
}

@article{Lacy1997,
