@article{ODonnell2004,
  title = {The Quality of Democracy: Why the Rule of Law Matters},
  shorttitle = {The Quality of Democracy},
  author = {O’Donnell, Guillermo},
  date = {2004},
  journaltitle = {Journal of Democracy},
