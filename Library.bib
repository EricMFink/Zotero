@article{Ohnesorge2007,
  title = {The Rule of Law},
  author = {Ohnesorge, John K. M.},
  date = {2007-12-01},
  journaltitle = {Annual Review of Law and Social Science},
  shortjournal = {Annu. Rev. Law Soc. Sci.},
  volume = {3},
  pages = {99--114},
