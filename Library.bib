@online{Britton-Purdy2024,
  type = {SSRN Scholarly Paper},
  title = {A Democratic Rule of Law},
  author = {Britton-Purdy, Jedediah S.},
  date = {2024-12-11},
  number = {5052568},
  eprint = {5052568},
  eprinttype = {Social Science Research Network},
  location = {Rochester, NY},
  url = {https://papers.ssrn.com/abstract=5052568},
  urldate = {2025-05-08},
  abstract = {Democracy and the rule of law aim at the same thing in different ways. Both aim to make the legal power of complex societies relatively acceptable to a reflective mind. They concern the regime’s accountability to those whom it governs. Yet these two principles address people in quite different registers: democracy addresses citizens, authors (or at least authorizers) of laws, while the rule of law addresses subjects, takers of law. The rule of law is entirely possible without democracy, but democracy is impossible, indeed, unintelligible without a certain kind of rule of law. This is so because law specifies the meaning of democracy’s key terms: who constitutes the demos, or people, and when the people may be said to have spoken. These are not natural facts, and come into being as political facts only through their articulation in law. The activity of democracy is thus itself dependent on the democratic rule of law.  American democracy suffers from deficiency in the democratic rule of law in three dimensions of canonical rule-of-law values: coherence, prospectivity, and feasibility. I illustrate these points with discussion of, respectively, the temporal and jurisdictional fragmentation of “the people,” the silence of existing law on the structure of federal constitutional conventions, and the near-impossibility of amending the national constitution.},
  langid = {english},
  pubstate = {prepublished},
  file = {/home/efink/Zotero/storage/5GDGWTNP/@Britton-Purdy2024.pdf}
}

