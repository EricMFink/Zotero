<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="2.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Casebook Bibliography</title>
	<id>https://emfink.net/Zotero/CSL-styles/casebook-bibliography.csl</id>
	<link href="https://github.com/EricMFink/Zotero/CSL-styles/casebook-bibliography.csl" rel="self"/>
	<link href="https://law.resource.org/pub/us/code/blue/IndigoBook.html" rel="documentation"/>
	<author>
		<name>Eric M. Fink</name>
		<email>efink@elon.edu</email>
	</author>
    <category citation-format="in-text"/>
    <category field="law"/>
    <summary>Reference style for casebooks, with inline short cites (case_name-date; author-title-date) and bibliography. Based on Bluebook Law Review and Chicago author-date</summary>
    <updated>2026-08-21T04:14:00-0400-04:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  
<locale>
  <style-options />
  <terms>
    <term name="editor" form="verb-short">ed.</term>
    <term name="translator" form="verb-short">trans.</term>
    <term name="number" form="long">number</term>
    <term name="number" form="short">no.</term>
    <term name="and" form="symbol">&amp;</term>
    <term name="article">article</term>
    <term name="director">director</term>
    <term form="short" name="director">dir.</term>
    <term form="short" name="article">
      <single>art.</single>
      <multiple>arts.</multiple>
    </term>
    <term name="rule">Rule</term>
    <term name="rule" form="short">r.</term>
    <term form="short" name="chapter">ch.</term>
    <term form="short" name="column">col.</term>
    <term form="short" name="figure">fig.</term>
    <term form="short" name="issue">no.</term>
    <term form="short" name="line">
      <single>l.</single>
      <multiple>ll.</multiple>
    </term>
    <term form="short" name="note">
      <single>n.</single>
      <multiple>nn.</multiple>
    </term>
    <term name="number">
      <single>number</single>
      <multiple>numbers</multiple>
    </term>
    <term name="number" form="short">
      <single>no.</single>
      <multiple>nos.</multiple>
    </term>
    <term form="short" name="opus">op.</term>
    <term form="short" name="page">
      <single>p.</single>
      <multiple>pp.</multiple>
    </term>
    <term form="short" name="paragraph">
      <single>para.</single>
      <multiple>paras.</multiple>
    </term>
    <term form="symbol" name="paragraph">
      <single>&#182;</single>
      <multiple>&#182;&#182;</multiple>
    </term>
    <term form="short" name="part">pt.</term>
    <term form="short" name="section">
      <single>sec.</single>
      <multiple>secs.</multiple>
    </term>
    <term form="symbol" name="section">
      <single>&#167;</single>
      <multiple>&#167;&#167;</multiple>
    </term>
    <term form="short" name="verse">vrs.</term>
    <term form="short" name="volume">vol.</term>
    <term form="short" name="edition">
      <single>ed.</single>
      <multiple>eds.</multiple>
    </term>
    <term form="short" name="supplement">
      <single>supp.</single>
      <multiple>supps.</multiple>
    </term>
    <term name="ibid">id.</term>
    <term form="verb" name="interview">interview by</term>
    <term form="short" name="translator">trans.</term>
    <term name="ordinal">th</term>
    <term name="ordinal-01">st</term>
    <term name="ordinal-02">d</term>
    <term name="ordinal-03">d</term>
    <term name="ordinal-11">th</term>
    <term name="ordinal-12">th</term>
    <term name="ordinal-13">th</term>
  </terms>
  <date form="text">
    <date-part form="short" name="month" suffix=" "/>
    <date-part form="numeric" name="day" suffix=", "/>
    <date-part name="year"/>
  </date>
</locale>
  
  <macro name="author">
    <names variable="author">
      <name and="symbol" delimiter=", " suffix=", "/>
      <label form="short" prefix=" "/>
    </names>
  </macro>

  <macro name="editor-translator">
    <names variable="editor translator" delimiter=", ">
      <name and="symbol" delimiter=", "/>
      <label form="short" strip-periods="false" prefix=" "/>
    </names>
  </macro>

  <macro name="title-inline">
    <choose>
      <if match="any" type="bill collection legislation regulation standard treaty">
        <text variable="title"/>
      </if>
      <else-if type="legal_case">
        <text font-style="italic" variable="title" form="short"/>
      </else-if>
      <else-if match="any" type="book hearing">
        <text font-style="italic" form="short" variable="title"/>
      </else-if>
      <else-if type="post">
        <text form="short" variable="title"/>
      </else-if>
      <else-if variable="container-title">
        <text form="short" variable="title"/>
      </else-if>
      <else-if match="any" type="article document manuscript webpage">
        <text form="short" variable="title"/>
      </else-if>
      <else>
        <text font-style="italic" form="short" variable="title"/>
      </else>
    </choose>
  </macro>
  
  <macro name="source">
    <choose>
      <if type="article-journal" match="any">
        <group delimiter=" ">
          <group delimiter=", ">
            <text variable="title" text-case="title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="volume"/>
              <text macro="container"/>
              <text variable="page-first"/>
            </group>
            <text variable="locator"/>
          </group>
          <text macro="issuance" prefix="(" suffix=")"/>
        </group>
      </if>
      <else-if type="legal_case">
        <group delimiter=" ">
          <group delimiter=" ">
            <text font-style="italic" variable="title" form="short" suffix=","/>
              <choose>
                <if variable="container-title">
                  <group delimiter=" ">
                    <text variable="volume"/>
                    <text macro="container"/>
                    <text variable="page-first"/>
                  </group>
                </if>
                <else>
                  <text variable="number"/>
                </else>
              </choose>
            <text macro="issuance" prefix="(" suffix=")"/>
          </group>
        </group>
      </else-if>
      <else-if type="legislation">
	  		<group delimiter=" ">
			<text variable="volume"/>
        	<text variable="container-title"/>
        	<text variable="section" prefix="§ "/>
		</group>
      </else-if>
      <else-if type="standard">
	  	<group delimiter=" ">
        	<text variable="genre"/>
        	<text variable="number"/>
		</group>
      </else-if>
      <else-if type="article-newspaper article-magazine" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="volume"/>
            <text macro="container"/>
          </group>
          <text macro="issuance"/>
          <group delimiter=" ">
            <text value="at"/>
            <text variable="page-first"/>
          </group>
        </group>
      </else-if>
      <else-if type="article thesis" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="title"/>
          <text macro="container"/>
        </group>
        <text macro="issuance" prefix=" (" suffix=")"/>
        <choose>
          <if type="thesis">
            <group delimiter=", " prefix=" (" suffix=")">
              <text variable="genre" suffix=" dissertation"/>
              <text variable="publisher"/>
            </group>
          </if>
        </choose>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <text variable="title" text-case="title" font-style="italic"/>
        <group prefix=", " delimiter=" " suffix=" ">
          <text variable="volume"/>
          <text macro="container"/>
        </group>
        <text variable="page-first"/>
        <text variable="locator" prefix=", "/>
        <text macro="issuance" prefix=" (" suffix=")"/>
      </else-if>
      <else-if type="book report" match="any">
        <text variable="title" text-case="title" font-variant="small-caps"/>
        <text variable="locator" prefix=" "/>
        <text macro="issuance" prefix=" (" suffix=")"/>
      </else-if>
      <else>
        <group delimiter=" ">
          <text variable="title" text-case="title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="volume"/>
            <text macro="container"/>
            <text variable="page-first"/>
            <text macro="issuance" prefix="(" suffix=")"/>
          </group>
        </group>
      </else>
    </choose>
  </macro>
  
  <macro name="issuance">
    <choose>
      <if match="any" variable="status">
        <group delimiter=" ">
          <text variable="status" text-case="capitalize-first"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <choose>
          <if type="article article-journal article-magazine article-newspaper broadcast interview manuscript map patent personal_communication song speech thesis webpage post-weblog" match="any">
            <group>
              <choose>
                <if type="article article-newspaper thesis webpage post-weblog" match="any">
                  <group>
                    <date variable="issued">
                      <date-part name="month" form="short" suffix=" "/>
                      <date-part name="day" prefix=" " suffix=", "/>
                    </date>
                  </group>
                </if>
                <else-if type="article-magazine">
                  <date variable="issued">
                    <date-part name="month" suffix=" " form="short"/>
                  </date>
                </else-if>
              </choose>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </if>
          <else-if type="legal_case">
            <group delimiter=" ">
              <text variable="authority" form="short"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </else-if>
          <else>
            <group delimiter=", ">
              <text macro="editor-translator"/>
              <group delimiter=" ">
                <group delimiter=" ">
                  <text variable="edition"/>
                  <label variable="edition" form="short"/>
                </group>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  
  <macro name="container">
    <choose>
      <if type="chapter paper-conference" match="any">
        <group>
          <text term="in" font-style="italic" prefix=" "/>
          <text variable="container-title" font-variant="small-caps" prefix=" "/>
        </group>
      </if>
      <else-if type="legal_case">
        <text variable="container-title" prefix=" "/>
      </else-if>
      <else-if type="article-journal">
        <text variable="container-title" form="short" font-variant="small-caps" prefix=" "/>
      </else-if>
      <else>
        <text variable="container-title" font-variant="small-caps"/>
      </else>
    </choose>
  </macro>

  <!-- Citation -->
  <macro name="citation-author-title">
    <choose>
      <if match="any" type="bill hearing legal_case legislation regulation treaty">
        <!-- Legal items have different orders and delimiters -->
        <text macro="source"/>
      </if>
      <else>
        <group delimiter=", ">
          <text macro="author" suffix=", "/>
          <text macro="source"/>
        </group>
      </else>
    </choose>
  </macro>
  
  <citation after-collapse-delimiter="; " collapse="year" disambiguate-add-givenname="true" disambiguate-add-names="true" disambiguate-add-year-suffix="true" et-al-min="4" et-al-use-first="1" givenname-disambiguation-rule="primary-name-with-initials">
    <layout delimiter="; " prefix="" suffix="">
      <text macro="citation-author-title"/>
    </layout>
  </citation>
  
  <!-- Bibliography -->
  <macro name="bibliography-author-title">
    <choose>
      <if match="any" type="bill hearing legal_case legislation regulation treaty">
        <!-- Legal items have different orders and delimiters -->
        <text macro="source"/>
      </if>
      <else>
        <group delimiter=", ">
          <text macro="author" suffix=","/>
          <text macro="source"/>
        </group>
      </else>
    </choose>
  </macro>

	<macro name="sort-key">
    <choose>
      <if type="legal_case" match="any">
        <text value="1"/>
      </if>
      <else>
        <text value="2"/>
      </else>
    </choose>
	</macro>

<macro name="year-sort">
  <choose>
    <if variable="issued">
      <date variable="issued" form="numeric" date-parts="year"/>
    </if>
    <else>
      <text term="no date" form="short"/>
    </else>
  </choose>
</macro>

  <bibliography et-al-min="7" et-al-use-first="3" hanging-indent="true">
  <sort>
    <key macro="sort-key"/>
    <key macro="author"/>
    <key macro="source"/>
    <key macro="year-sort"/>
  </sort>
    <layout suffix="">
      <text macro="bibliography-author-title"/>
    </layout>
  </bibliography>
</style>
