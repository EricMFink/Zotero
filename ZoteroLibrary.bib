@article{Rozema2021,
  title = {Does the Bar Exam Protect the Public?},
  author = {Rozema, Kyle},
  year = {2021},
  journal = {Journal of Empirical Legal Studies},
  volume = {18},
  number = {4},
  pages = {801--848},
