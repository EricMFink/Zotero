@article{Murthy2020,
  title = {Beyond Particularity and Universality: Moishe Postone and the Possibilities of Jewish Marxism},
  shorttitle = {Beyond Particularity and Universality},
  author = {Murthy, Viren},
  year = 2020,
  journal = {Jewish Social Studies; Bloomington},
  volume = {25},
