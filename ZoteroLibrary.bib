@article{Meyer1996,
  title = {Movements, Countermovements, and the Structure of Political Opportunity},
  author = {Meyer, David S. and Staggenborg, Suzanne},
  year = {1996},
  journal = {American Journal of Sociology},
  volume = {101},
  number = {6},
  pages = {1628--1660},
