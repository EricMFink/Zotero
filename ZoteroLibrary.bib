@misc{ArkansasDataTrespass2017,
  title = {Arkansas Data Trespass},
  year = {2017},
  chapter = {16-118-113},
  keywords = {ag-gag,ObsCite,statutes},
  note = {\textbf{Extracted Annotations (2/10/2023, 9:42:13 PM)}
\par
"(a) As used in this section: (1) "Commercial property" means: (A) A business property; (B) Agricultural or timber production operations, including buildings and all outdoor areas that are not open to the public; and (C) Residential property used for business purposes" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=1}{ 2017:1})
\par
"an employee" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=1}{ 2017:1})
\par
"in a manner that damages the employer;" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=1}{ 2017:1})
\par
\emph{Arkansas statute says "in a manner that damages the employer" instead of "breach of duty of loyalty". "Damage" isn't defined. This could include even more PCA than the NC version. (\href{zotero://open-pdf/library/items/W2BQL5EY?page=1}{note on p.1})}
\par
"in a manner that damages the employer" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=1}{ 2017:1})
\par
"for an unlawful purpose" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=2}{ 2017:2})
\par
"(f) This section does not: (1) Diminish the protections provided to employees under state or federal law;" (\href{zotero://open-pdf/library/items/W2BQL5EY?page=2}{ 2017:2})
\par
\emph{"for an unlawful purpose" presumably means unlawful under some other law. This implies that liability under (1) and (2) doesn't require that the employee's use of the information or recording is otherwise illegal, just that it damages the employer.  (\href{zotero://open-pdf/library/items/W2BQL5EY?page=2}{note on p.2})}
\par
\emph{While this recognizes that federal law may protect conduct subject to liability under this law, it doesn't really avoid the preemption problem.  (\href{zotero://open-pdf/library/items/W2BQL5EY?page=2}{note on p.2})}},
  file = {/home/efink/Notes/Zotero/PDF/DataTrespass/AgGag Statutes/@ArkansasDataTrespass2017.pdf}
}

