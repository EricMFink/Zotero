@misc{EastexIncNLRB1978,
  title = {Eastex, Inc. v. NLRB},
  shorttitle = {Eastex},
  year = {1978},
  volume = {437},
  pages = {556},
  keywords = {ObsCite,protected-concerted-activity},
  note = {\textbf{Extracted Annotations (6/19/2023, 3:25:29 PM)}
\par
"Employees of petitioner sought to distribute a union newsletter in nonworking areas of petitioner's property during nonworking time urging employees to support the union and discussing a proposal to incorporate the state "right-to-work" statute into the state constitution and a Presidential veto of an increase in the federal minimum wage. The newsletter also called on employees to take action to protect their interests as employees with respect to these two issues" (\href{zotero://open-pdf/library/items/IE3DYF3P?page=1}{ 1978:1})
\par
"The "employees" who may engage in concerted activities for "mutual aid or protection" are defined by {\S} 2 (3) of the Act, 29 U. S. C. {\S} 152 (3), to "include any employee, and shall not be limited to the employees of a particular employer, unless this subchapter explicitly states otherwise . . . ." This definition was intended to protect employees when they engage in otherwise proper concerted activities in support of employees of employers other than their own" (\href{zotero://open-pdf/library/items/IE3DYF3P?page=3}{ 1978:3})
\par
"We also find no warrant for petitioner's view that employees lose their protection under the "mutual aid or protection" clause when they seek to improve terms and conditions of employment or otherwise improve their lot as employees through channels outside the immediate employee-employer relationship." (\href{zotero://open-pdf/library/items/IE3DYF3P?page=3}{ 1978:3})
\par
"the "mutual aid or *566 protection" clause protects employees from retaliation by their employers when they seek to improve working conditions through resort to administrative and judicial forums,[15] and that employees' appeals to legislators to protect their interests as employees are within the scope of this clause" (\href{zotero://open-pdf/library/items/IE3DYF3P?page=3}{ 1978:3})},
  file = {/home/efink/Notes/Zotero/PDF/DataTrespass/Protected Concerted Activity/@EastexIncNLRB1978.pdf;/home/efink/Zotero/storage/K8TYAANR/scholar_case.html}
