@misc{CenterforConstitutionalRights2017,
  title = {Ag-Gag Across America: Corporate-Backed Attacks on Activitsts and Whistleblowers},
  shorttitle = {Ag-Gag Across America},
  author = {{Center for Constitutional Rights}},
  year = {2017},
  keywords = {ObsCite},
  note = {\textbf{Extracted Annotations (2/10/2023, 5:40:35 PM)}
\par
"ag-gag laws vary, but all include one or more of three key elements: (1) prohibiting documentation of agricultural practices; (2) prohibiting misrepresentations in job applications utilized to gain access to closed facilities; and (3) requiring immediate reporting of illegal animal cruelty." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=4}{Center for Constitutional Rights 2017:4})
\par
"In recent years, these measures have expanded beyond the agricultural industry to target whistleblowers more broadly. In 2017, the governor of Arkansas signed into law an expansive ag-gag bill that aims to silence whistleblowers in agriculture, child care, and nursing facilities." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=7}{Center for Constitutional Rights 2017:7})
\par
"The term "ag-gag" was coined in 2011 by former New York Times columnist Mark Bittman to describe a series of state bills appearing across the country that criminalized photographing and video recording inside agricultural facilities." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"Prohibiting documentation, i.e. banning photography, video recordings, and collection of documents;" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"Prohibiting misrepresenting oneself in order to gain access" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"Requiring the quick reporting to authorities of illegal animal cruelty" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"Some impose criminal liability; others impose civil liability" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"Some laws single out only animal enterprises for special protection, while others are blanket prohibitions on whistleblowing in all industries." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=8}{Center for Constitutional Rights 2017:8})
\par
"In 2013, Utah became the first state to charge an individual under an ag-gag law." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=18}{Center for Constitutional Rights 2017:18})
\par
"The charges were dropped within 24 hours of the story breaking, after widespread public outrage." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=18}{Center for Constitutional Rights 2017:18})
\par
"In 2014, Utah again used its ag-gag law, this time to arrest four activists from the Farm Animal Rights Movement." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=18}{Center for Constitutional Rights 2017:18})
\par
"prosecutors dropped the ag-gag charges." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=18}{Center for Constitutional Rights 2017:18})
\par
"The most dramatic evolution during the second wave has been the expansion of ag-gag bills beyond the agricultural and animal industries." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=20}{Center for Constitutional Rights 2017:20})
\par
""data trespass,"" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=20}{Center for Constitutional Rights 2017:20})
\par
"In response to legal challenges (see below) the Wyoming legislature amended both data trespass laws in 2016. "Open lands" was replaced by the phrase "private land" and the definition of "collect" was altered to strike the requirement the data be submitted or intended to be submitted to government agency." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=21}{Center for Constitutional Rights 2017:21})
\par
"North Carolina's 2015 ag-gag law also represents a significant broadening of ag-gag legislation." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=21}{Center for Constitutional Rights 2017:21})
\par
"it does not single out the agricultural industry for protection allows employers to sue any employee" (\href{zotero://open-pdf/library/items/TWPBLHN4?page=21}{Center for Constitutional Rights 2017:21})
\par
"The law follows the North Carolina model, imposing civil (as opposed to criminal) liability, and targeting whistleblowers generally, instead of singling out agricultural industry for special protection." (\href{zotero://open-pdf/library/items/TWPBLHN4?page=22}{Center for Constitutional Rights 2017:22})
