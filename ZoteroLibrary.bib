@misc{RPC163,
  title = {RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict},
  year = {1994},
  month = apr,
  publisher = {NC State Bar},
  urldate = {2024-07-09},
  note = {\section{Annotations (8/11/2024, 10:09:26 PM)}

\par
``REQUEST FOR INDEPENDENT GUARDIAN AD LITEM WHERE EXISTING GUARDIAN HAS CONFLICT'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``Adopted:April15,1994'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``anattorneymayseektheappointmentofanindependentguardianadlitemforachildwhoseguardianhasanobvious conflictofinterestinfulfillinghisfiduciarydutiestothechild.'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``A's father, F, and M originally asked Attorney X to represent both M and A. Attorney X explained that there appeared to be a conflict of interest between M and A and that Attorney X would be willing to represent only A. M and F agreed. Attorney X entered into a fee agreement with F signing as guardian for A. No lawsuit has been filed at this time. After investigating the motor vehicle accident, Attorney X concluded that M was most likely negligent, although the driver/owner of the oncoming vehicle may also have been negligent. F left a telephone message for Attorney X indicating that he was no longer interested in pursuing A's claims since it appeared likely that M would be the major defendant and if a judgment was entered against her, it would raise F and M's automobile insurance rates.'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``Attorney X believes that A's parents are not acting in A's best interests. They appear to be protecting their own interests to the exclusion of A's interests. Having advised F that Attorney X believes that he has an ethical and moral duty to proceed, is Attorney X's ethical duty satisfied?'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``Yes.'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``on these particular facts, where F's only stated reason for failing to pursue his daughter's claim is the protection of the family's automobile insurance rates and no other concerns or contingencies have been indicated by F, it would be permissible for Attorney X to seek the appointment of an independent guardian ad litem to represent A's interests. This would be consistent with Attorney X's primary duty to represent the interest of A, who is the real party in interest. See CPR 15.'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``May Attorney X seek the appointment of an independent guardian ad litem and proceed with filing suit after the independent guardian ad litem has reviewed the case and agrees that Attorney X should proceed?'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})
\par
``Yes.'' (\href{zotero://select/library/items/WJXDNE69}{``RPC 163: Request for Independent Guardian Ad Litem Where Existing Guardian Has Conflict'', 1994, p. 1})},
  file = {/home/efink/Notes/Zotero/PDF/Law/Guardianships/@RPC163.pdf}
}

@misc{RPC249,
  title = {RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate},
  year = {1997},
  month = apr,
  publisher = {NC State Bar},
  urldate = {2024-07-09},
  note = {\section{Annotations (8/11/2024, 10:09:31 PM)}

\par
``COMMUNICATION WITH A CHILD REPRESENTED BY GAL AND ATTORNEY ADVOCATE'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``Adopted:April04,1997'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``lawyermaynotcommunicatewithachildwhoisrepresentedbyaGALandanattorneyadvocateunlessthelawyer obtainstheconsentoftheattorneyadvocate.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``The attorney for Joey's mother, Attorney M, would like to interview Joey without informing the GAL or the attorney advocate. May he do so?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``Rule 7.4(1) provides that, during the course of his or her representation of a client, a lawyer is prohibited from communicating or causing another to communicate about the subject of the representation with a party the lawyer knows to be represented by another lawyer in the matter unless the lawyer has the consent of the other lawyer or is authorized by law to do so. Joey is represented by an attorney, and the attorney advocate's consent must be obtained prior to any communication by Attorney M with Joey.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``Is the permission of the attorney for DSS sufficient to allow Attorney M to interview Joey without the consent of the attorney advocate?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``No, the attorney for DSS does not represent Joey.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``The district attorney intends to prosecute the mother for child abuse. The district attorney would like to interview Joey without informing or obtaining the consent of the GAL or the attorney advocate. May the district attorney interview Joey under these circumstances?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``No. The comment to Rule 7.4 states, "This rule also covers any person, whether or not a party to a formal proceeding, who is represented by counsel concerning the matter in question." See also RPC 87.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``May the district attorney instruct a sheriff's deputy to interview Joey without informing or obtaining the consent of the GAL or the attorney advocate?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``No, an attorney may not instruct an agent to do that which the attorney cannot do. See Rule 3.3.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 1})
\par
``If the GAL is also an attorney, would any of the above opinions be different?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 2})
\par
``No. If an attorney advocate was appointed, the GAL is not acting in the capacity of an attorney for the juvenile. Rule 7.4(d) requires the consent of the attorney representing the client prior to direct communication with the client.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 2})
\par
``If the court appoints a GAL for Joey but does not appoint an attorney advocate, may the attorney for Joey's mother, the district attorney, or the attorney for DSS interview Joey without the consent of the GAL?'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 2})
\par
``No, the consent of the GAL must be obtained before communicating with Joey. This is consistent with the policy and purpose behind G.S. {\S}71-586. See also RPC 61.'' (\href{zotero://select/library/items/ISQKHNAG}{``RPC 249: Communnication with a Child Represented by GAL and Attorney Advocate'', 1997, p. 2})},
  file = {/home/efink/Notes/Zotero/PDF/Law/Guardianships/@RPC249.pdf}
}

