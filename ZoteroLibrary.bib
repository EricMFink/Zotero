@article{Suntrup2020,
  title = {Between Prerogative Power and Legality -- Reading Ernst Fraenkel's The Dual State as an Analytical Tool for Present Authoritarian Rule},
  author = {Suntrup, Jan Christoph},
  year = {2020},
  month = jul,
  journal = {Jurisprudence},
